      "heading": "Planned configuration",
      "content": "{\n  \"PHAL\": {\n    \"admin\": {\n      \"ovos-PHAL-plugin-netpolicy\": {\n        \"enabled\": true,\n        \"fail_closed\": true,\n        \"routes\": {\n          \"ovos-core.service\": \"tor\",\n          \"ovos-dinkum-listener.service\": \"direct\",\n          \"ovos-audio.service\": \"direct\",\n          \"ovos-phal.service\": \"direct\"\n        },\n        \"lan_allow\": [\"127.0.0.0/8\", \"192.168.0.0/16\", \"10.0.0.0/8\"],\n        \"direct_allow\": [],\n        \"block_ipv6\": true,\n        \"tor\": {\n          \"binary\": \"tor\",\n          \"install_tor\": false,\n          \"trans_port\": 9040,\n          \"dns_port\": 5353,\n          \"control_port\": 9051\n        }\n      }\n    }\n  }\n}"
